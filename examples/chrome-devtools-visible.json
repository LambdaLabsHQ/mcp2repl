{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--isolated",
        "--viewport=1440x1000",
        "--no-usage-statistics",
        "--no-performance-crux",
        "--chrome-arg=--lang=en-US",
        "--chrome-arg=--accept-lang=en-US,en",
        "--chrome-arg=--disable-features=Translate"
      ]
    }
  }
}
